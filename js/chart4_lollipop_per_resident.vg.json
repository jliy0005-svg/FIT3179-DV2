{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "description": "Lollipop chart of annual public transport trips per resident across Australian capital cities.",

  "width": 650,
  "height": 350,

  "data": {
    "url": "https://raw.githubusercontent.com/jliy0005-svg/FIT3179-DV2/main/data/city_summary_chart_ready.csv"
  },

  "layer": [

    {
      "mark": {
        "type": "rule",
        "strokeWidth": 2
      },

      "encoding": {

        "y": {
          "field": "City",
          "type": "nominal",

          "sort": [
            "Sydney",
            "Melbourne",
            "Perth",
            "Brisbane",
            "Adelaide",
            "Canberra",
            "Darwin",
            "Hobart"
          ],

          "axis": {
            "title": null,
            "labelFontSize": 12,
            "labelPadding": 8
          }
        },

        "x": {
          "field": "Trips_Per_Resident_2024_25",
          "type": "quantitative",

          "scale": {
            "domain": [0, 135]
          },

          "axis": {
            "title": "Annual trips per resident (2024–25)",
            "grid": false,
            "domain": false,
            "tickCount": 6,
            "labelFontSize": 11,
            "titleFontSize": 12
          }
        },

        "x2": {
          "datum": 0
        },

        "color": {
          "condition": {
            "test": "datum.Trips_Per_Resident_2024_25 >= 59.5",
            "value": "#173F5F"
          },

          "value": "#C4D0D8"
        }
      }
    },

    {
      "mark": {
        "type": "circle",
        "size": 110,
        "stroke": "#FFFFFF",
        "strokeWidth": 1
      },

      "encoding": {

        "y": {
          "field": "City",
          "type": "nominal",

          "sort": [
            "Sydney",
            "Melbourne",
            "Perth",
            "Brisbane",
            "Adelaide",
            "Canberra",
            "Darwin",
            "Hobart"
          ]
        },

        "x": {
          "field": "Trips_Per_Resident_2024_25",
          "type": "quantitative",

          "scale": {
            "domain": [0, 135]
          }
        },

        "color": {
          "condition": {
            "test": "datum.Trips_Per_Resident_2024_25 >= 59.5",
            "value": "#173F5F"
          },

          "value": "#8FA6B8"
        },

        "tooltip": [
          {
            "field": "City",
            "type": "nominal",
            "title": "Capital city"
          },
          {
            "field": "Trips_Per_Resident_2024_25",
            "type": "quantitative",
            "title": "Trips per resident",
            "format": ".1f"
          },
          {
            "field": "Total_Trips_Million_2024_25",
            "type": "quantitative",
            "title": "Passenger trips (million)",
            "format": ".1f"
          }
        ]
      }
    },

    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 9,
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#27343D"
      },

      "encoding": {

        "y": {
          "field": "City",
          "type": "nominal",

          "sort": [
            "Sydney",
            "Melbourne",
            "Perth",
            "Brisbane",
            "Adelaide",
            "Canberra",
            "Darwin",
            "Hobart"
          ]
        },

        "x": {
          "field": "Trips_Per_Resident_2024_25",
          "type": "quantitative",

          "scale": {
            "domain": [0, 135]
          }
        },

        "text": {
          "field": "Trips_Per_Resident_2024_25",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    },

    {
      "data": {
        "values": [
          {
            "Average": 59.5
          }
        ]
      },

      "mark": {
        "type": "rule",
        "stroke": "#657786",
        "strokeWidth": 1.5,
        "strokeDash": [5, 4]
      },

      "encoding": {

        "x": {
          "field": "Average",
          "type": "quantitative",

          "scale": {
            "domain": [0, 135]
          }
        }
      }
    },

    {
      "data": {
        "values": [
          {
            "Average": 59.5,
            "Label": "Capital-city average 59.5"
          }
        ]
      },

      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "dx": 6,
        "dy": 5,
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#657786"
      },

      "encoding": {

        "x": {
          "field": "Average",
          "type": "quantitative",

          "scale": {
            "domain": [0, 135]
          }
        },

        "y": {
          "value": 0
        },

        "text": {
          "field": "Label",
          "type": "nominal"
        }
      }
    }

  ],

  "config": {

    "background": null,

    "view": {
      "stroke": null
    },

    "font": "Barlow"
  }
}
