{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "description": "Bullet chart comparing 2024-25 public transport patronage with each capital city's 2018-19 pre-COVID level.",

  "width": 650,
  "height": 330,

  "data": {
    "url": "https://raw.githubusercontent.com/jliy0005-svg/FIT3179-DV2/main/data/recovery_2025.csv"
  },

  "layer": [

    {
      "mark": {
        "type": "bar",
        "size": 20,
        "color": "#EEF1F3"
      },

      "encoding": {

        "y": {
          "field": "City",
          "type": "nominal",

          "sort": {
            "field": "Recovery_Index",
            "order": "descending"
          },

          "axis": {
            "title": null,
            "labelFontSize": 11,
            "labelPadding": 8
          }
        },

        "x": {
          "datum": 0,
          "type": "quantitative",

          "scale": {
            "domain": [0, 120]
          },

          "axis": {
            "title": "Recovery index (2018–19 = 100)",
            "values": [0, 20, 40, 60, 80, 100, 120],
            "grid": false,
            "domain": false,
            "labelFontSize": 11,
            "titleFontSize": 12
          }
        },

        "x2": {
          "datum": 100
        }
      }
    },

    {
      "mark": {
        "type": "bar",
        "size": 20,
        "color": "#DCEEEA"
      },

      "encoding": {

        "y": {
          "field": "City",
          "type": "nominal",

          "sort": {
            "field": "Recovery_Index",
            "order": "descending"
          }
        },

        "x": {
          "datum": 100,
          "type": "quantitative",

          "scale": {
            "domain": [0, 120]
          }
        },

        "x2": {
          "datum": 120
        }
      }
    },

    {
      "mark": {
        "type": "bar",
        "size": 8,
        "color": "#173F5F"
      },

      "encoding": {

        "y": {
          "field": "City",
          "type": "nominal",

          "sort": {
            "field": "Recovery_Index",
            "order": "descending"
          }
        },

        "x": {
          "field": "Recovery_Index",
          "type": "quantitative",

          "scale": {
            "domain": [0, 120]
          }
        },

        "x2": {
          "datum": 0
        },

        "tooltip": [
          {
            "field": "City",
            "type": "nominal",
            "title": "Capital city"
          },
          {
            "field": "Pre_COVID_Trips_Million_2018_19",
            "type": "quantitative",
            "title": "2018–19 trips (million)",
            "format": ".1f"
          },
          {
            "field": "Trips_Million_2024_25",
            "type": "quantitative",
            "title": "2024–25 trips (million)",
            "format": ".1f"
          },
          {
            "field": "Recovery_Index",
            "type": "quantitative",
            "title": "Recovery index",
            "format": ".1f"
          }
        ]
      }
    },

    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 55,
        "color": "#173F5F",
        "stroke": "#FFFFFF",
        "strokeWidth": 1
      },

      "encoding": {

        "y": {
          "field": "City",
          "type": "nominal",

          "sort": {
            "field": "Recovery_Index",
            "order": "descending"
          }
        },

        "x": {
          "field": "Recovery_Index",
          "type": "quantitative",

          "scale": {
            "domain": [0, 120]
          }
        }
      }
    },

    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#27343D"
      },

      "encoding": {

        "y": {
          "field": "City",
          "type": "nominal",

          "sort": {
            "field": "Recovery_Index",
            "order": "descending"
          }
        },

        "x": {
          "field": "Recovery_Index",
          "type": "quantitative",

          "scale": {
            "domain": [0, 120]
          }
        },

        "text": {
          "field": "Recovery_Index",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    },

    {
      "data": {
        "values": [
          {
            "Target": 100
          }
        ]
      },

      "mark": {
        "type": "rule",
        "stroke": "#566573",
        "strokeWidth": 1.3,
        "strokeDash": [5, 4]
      },

      "encoding": {

        "x": {
          "field": "Target",
          "type": "quantitative",

          "scale": {
            "domain": [0, 120]
          }
        }
      }
    },

    {
      "data": {
        "values": [
          {
            "Target": 100,
            "Label": "100 = 2018–19 level"
          }
        ]
      },

      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "dx": 6,
        "dy": 4,
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#566573"
      },

      "encoding": {

        "x": {
          "field": "Target",
          "type": "quantitative",

          "scale": {
            "domain": [0, 120]
          }
        },

        "y": {
          "value": 0
        },

        "text": {
          "field": "Label",
          "type": "nominal"
        }
      }
    }

  ],

  "config": {

    "background": null,

    "view": {
      "stroke": null
    },

    "font": "Barlow"
  }
}
