{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 650,
  "height": 380,

  "data": {
    "url": "https://raw.githubusercontent.com/jliy0005-svg/FIT3179-DV2/main/data/recovery_2025.csv",

    "format": {
      "type": "csv",

      "parse": {
        "Pre_COVID_Trips_Million_2018_19": "number",
        "Trips_Million_2024_25": "number",
        "Recovery_Index": "number",
        "Recovery_Percent_Change": "number",
        "Target_Index": "number"
      }
    }
  },

  "transform": [
    {
      "calculate": "0",
      "as": "Range_Start"
    },
    {
      "calculate": "80",
      "as": "Range_80"
    },
    {
      "calculate": "100",
      "as": "Range_100"
    },
    {
      "calculate": "120",
      "as": "Range_120"
    }
  ],

  "layer": [

    {
      "mark": {
        "type": "bar",
        "size": 30,
        "color": "#F0F2F4"
      },

      "encoding": {

        "y": {
          "field": "City",
          "type": "nominal",

          "sort": {
            "field": "Recovery_Index",
            "order": "descending"
          },

          "title": null,

          "axis": {
            "labelFontSize": 12,
            "labelPadding": 8
          }
        },

        "x": {
          "field": "Range_Start",
          "type": "quantitative",

          "scale": {
            "domain": [0, 120]
          },

          "axis": null
        },

        "x2": {
          "field": "Range_120"
        }
      }
    },


    {
      "mark": {
        "type": "bar",
        "size": 30,
        "color": "#DDE3E7"
      },

      "encoding": {

        "y": {
          "field": "City",
          "type": "nominal",

          "sort": {
            "field": "Recovery_Index",
            "order": "descending"
          }
        },

        "x": {
          "field": "Range_80",
          "type": "quantitative"
        },

        "x2": {
          "field": "Range_100"
        }
      }
    },


    {
      "mark": {
        "type": "bar",
        "size": 30,
        "color": "#D9ECE8"
      },

      "encoding": {

        "y": {
          "field": "City",
          "type": "nominal",

          "sort": {
            "field": "Recovery_Index",
            "order": "descending"
          }
        },

        "x": {
          "field": "Range_100",
          "type": "quantitative"
        },

        "x2": {
          "field": "Range_120"
        }
      }
    },


    {
      "mark": {
        "type": "bar",
        "size": 12,
        "color": "#173F5F"
      },

      "encoding": {

        "y": {
          "field": "City",
          "type": "nominal",

          "sort": {
            "field": "Recovery_Index",
            "order": "descending"
          }
        },

        "x": {
          "field": "Range_Start",
          "type": "quantitative",

          "title": "Recovery index (2018–19 = 100)",

          "scale": {
            "domain": [0, 120]
          },

          "axis": {
            "values": [
              0,
              20,
              40,
              60,
              80,
              100,
              120
            ],

            "grid": false,
            "labelFontSize": 11,
            "titleFontSize": 12
          }
        },

        "x2": {
          "field": "Recovery_Index"
        },

        "tooltip": [

          {
            "field": "City",
            "type": "nominal",
            "title": "Capital city"
          },

          {
            "field": "Recovery_Index",
            "type": "quantitative",
            "title": "Recovery index",
            "format": ".1f"
          },

          {
            "field": "Recovery_Percent_Change",
            "type": "quantitative",
            "title": "Change vs 2018–19",
            "format": "+.1f"
          },

          {
            "field": "Pre_COVID_Trips_Million_2018_19",
            "type": "quantitative",
            "title": "2018–19 trips (million)",
            "format": ".1f"
          },

          {
            "field": "Trips_Million_2024_25",
            "type": "quantitative",
            "title": "2024–25 trips (million)",
            "format": ".1f"
          },

          {
            "field": "Recovery_Status",
            "type": "nominal",
            "title": "Recovery status"
          }

        ]
      }
    },


    {
      "mark": {
        "type": "tick",
        "color": "#374151",
        "thickness": 2.5,
        "size": 28
      },

      "encoding": {

        "y": {
          "field": "City",
          "type": "nominal",

          "sort": {
            "field": "Recovery_Index",
            "order": "descending"
          }
        },

        "x": {
          "field": "Target_Index",
          "type": "quantitative"
        }
      }
    },


    {
      "mark": {
        "type": "circle",
        "size": 80,
        "color": "#173F5F",
        "stroke": "white",
        "strokeWidth": 1
      },

      "encoding": {

        "y": {
          "field": "City",
          "type": "nominal",

          "sort": {
            "field": "Recovery_Index",
            "order": "descending"
          }
        },

        "x": {
          "field": "Recovery_Index",
          "type": "quantitative"
        }
      }
    },


    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 8,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#374151"
      },

      "encoding": {

        "y": {
          "field": "City",
          "type": "nominal",

          "sort": {
            "field": "Recovery_Index",
            "order": "descending"
          }
        },

        "x": {
          "field": "Recovery_Index",
          "type": "quantitative"
        },

        "text": {
          "field": "Recovery_Index",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    },


    {
      "data": {
        "values": [
          {
            "Target": 100
          }
        ]
      },

      "mark": {
        "type": "rule",
        "strokeDash": [5, 4],
        "strokeWidth": 1.5,
        "color": "#6B7280"
      },

      "encoding": {

        "x": {
          "field": "Target",
          "type": "quantitative"
        }
      }
    }

  ],

  "config": {

    "background": "white",

    "view": {
      "stroke": null
    },

    "font": "Arial",

    "axis": {
      "domain": false,
      "tickColor": "#CBD5E1",
      "labelColor": "#4B5563",
      "titleColor": "#374151"
    }

  }
}
