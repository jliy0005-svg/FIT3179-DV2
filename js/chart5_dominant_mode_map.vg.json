{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "description": "Graduated symbol map showing each Australian capital city's dependence on buses in 2024-25.",

  "width": 650,
  "height": 410,

  "projection": {
    "type": "equalEarth"
  },

  "layer": [

    {
      "data": {
        "url": "https://raw.githubusercontent.com/vega/vega-datasets/master/data/world-110m.json",

        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },

      "transform": [
        {
          "filter": "datum.id == 36"
        }
      ],

      "mark": {
        "type": "geoshape",
        "fill": "#E8ECEF",
        "stroke": "#AAB4BC",
        "strokeWidth": 0.8
      }
    },

    {
      "data": {
        "url": "https://raw.githubusercontent.com/jliy0005-svg/FIT3179-DV2/main/data/city_summary_chart_ready.csv"
      },

      "transform": [

        {
          "calculate": "datum.Bus_Trips_Million_2024_25 / datum.Total_Trips_Million_2024_25 * 100",
          "as": "Bus_Share"
        },

        {
          "calculate": "datum.Bus_Share < 30 ? 'Low (<30%)' : datum.Bus_Share < 50 ? 'Moderate (30–49%)' : datum.Bus_Share < 75 ? 'High (50–74%)' : 'Very high (75%+)'",
          "as": "Bus_Class"
        }

      ],

      "mark": {
        "type": "circle",
        "opacity": 0.9,
        "stroke": "#FFFFFF",
        "strokeWidth": 1.2
      },

      "encoding": {

        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },

        "size": {
          "field": "Bus_Class",
          "type": "ordinal",

          "sort": [
            "Low (<30%)",
            "Moderate (30–49%)",
            "High (50–74%)",
            "Very high (75%+)"
          ],

          "scale": {

            "domain": [
              "Low (<30%)",
              "Moderate (30–49%)",
              "High (50–74%)",
              "Very high (75%+)"
            ],

            "range": [
              90,
              280,
              650,
              1200
            ]
          },

          "legend": {
            "title": "Bus share class",
            "orient": "bottom",
            "direction": "horizontal",
            "titleFontSize": 12,
            "labelFontSize": 11
          }
        },

        "color": {
          "field": "Bus_Class",
          "type": "ordinal",

          "scale": {

            "domain": [
              "Low (<30%)",
              "Moderate (30–49%)",
              "High (50–74%)",
              "Very high (75%+)"
            ],

            "range": [
              "#B7E4DC",
              "#70C7BA",
              "#2A9D8F",
              "#176B61"
            ]
          },

          "legend": null
        },

        "tooltip": [
          {
            "field": "City",
            "type": "nominal",
            "title": "Capital city"
          },
          {
            "field": "Bus_Share",
            "type": "quantitative",
            "title": "Bus share of trips",
            "format": ".1f"
          },
          {
            "field": "Bus_Trips_Million_2024_25",
            "type": "quantitative",
            "title": "Bus trips (million)",
            "format": ".1f"
          },
          {
            "field": "Total_Trips_Million_2024_25",
            "type": "quantitative",
            "title": "All public transport trips (million)",
            "format": ".1f"
          }
        ]
      }
    },

    {
      "data": {
        "url": "https://raw.githubusercontent.com/jliy0005-svg/FIT3179-DV2/main/data/city_summary_chart_ready.csv"
      },

      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 600,
        "dy": -15,
        "color": "#27343D"
      },

      "encoding": {

        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },

        "text": {
          "field": "City",
          "type": "nominal"
        }
      }
    }

  ],

  "config": {

    "background": null,

    "view": {
      "stroke": null
    },

    "font": "Barlow"
  }
}
