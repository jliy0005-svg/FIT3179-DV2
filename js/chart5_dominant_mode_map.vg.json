{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 650,
  "height": 430,

  "projection": {
    "type": "mercator"
  },

  "layer": [

    {
      "data": {
        "url": "https://vega.github.io/vega-datasets/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },

      "transform": [
        {
          "filter": "datum.id == 36"
        }
      ],

      "mark": {
        "type": "geoshape",
        "fill": "#E8ECEF",
        "stroke": "#AAB4BC",
        "strokeWidth": 0.8
      }
    },

    {
      "data": {
        "url": "https://raw.githubusercontent.com/jliy0005-svg/FIT3179-DV2/main/data/mode_share_2025.csv",

        "format": {
          "type": "csv",

          "parse": {
            "Mode_Share_Percent_2024_25": "number",
            "Trips_Million_2024_25": "number"
          }
        }
      },

      "transform": [

        {
          "filter": "datum.Mode == 'Bus'"
        },

        {
          "lookup": "City",

          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/jliy0005-svg/FIT3179-DV2/main/data/city_summary_chart_ready.csv",

              "format": {
                "type": "csv",

                "parse": {
                  "Latitude": "number",
                  "Longitude": "number",
                  "Total_Trips_Million_2024_25": "number"
                }
              }
            },

            "key": "City",

            "fields": [
              "Latitude",
              "Longitude",
              "Total_Trips_Million_2024_25"
            ]
          }
        },

        {
          "calculate": "datum.Mode_Share_Percent_2024_25 < 30 ? 'Low (<30%)' : datum.Mode_Share_Percent_2024_25 < 50 ? 'Moderate (30–49%)' : datum.Mode_Share_Percent_2024_25 < 75 ? 'High (50–74%)' : 'Very high (75%+)'",
          "as": "Bus_Dependency_Class"
        }

      ],

      "mark": {
        "type": "circle",
        "color": "#2A9D8F",
        "opacity": 0.9,
        "stroke": "white",
        "strokeWidth": 1.5
      },

      "encoding": {

        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },

        "size": {
          "field": "Bus_Dependency_Class",
          "type": "nominal",

          "title": "Bus share class",

          "scale": {
            "domain": [
              "Low (<30%)",
              "Moderate (30–49%)",
              "High (50–74%)",
              "Very high (75%+)"
            ],

            "range": [
              120,
              320,
              650,
              1100
            ]
          },

          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "titleFontSize": 12,
            "labelFontSize": 11
          }
        },

        "tooltip": [

          {
            "field": "City",
            "type": "nominal",
            "title": "Capital city"
          },

          {
            "field": "Mode_Share_Percent_2024_25",
            "type": "quantitative",
            "title": "Bus share of trips",
            "format": ".1f"
          },

          {
            "field": "Bus_Dependency_Class",
            "type": "nominal",
            "title": "Bus dependence"
          },

          {
            "field": "Trips_Million_2024_25",
            "type": "quantitative",
            "title": "Bus trips (million)",
            "format": ".1f"
          },

          {
            "field": "Total_Trips_Million_2024_25",
            "type": "quantitative",
            "title": "Total trips (million)",
            "format": ".1f"
          }

        ]
      }
    },


    {
      "data": {
        "url": "https://raw.githubusercontent.com/jliy0005-svg/FIT3179-DV2/main/data/city_summary_chart_ready.csv",

        "format": {
          "type": "csv",

          "parse": {
            "Latitude": "number",
            "Longitude": "number"
          }
        }
      },

      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "dy": -20,
        "color": "#27343D"
      },

      "encoding": {

        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },

        "text": {
          "field": "City",
          "type": "nominal"
        }
      }
    }

  ],

  "config": {

    "background": "white",

    "view": {
      "stroke": null
    },

    "font": "Arial",

    "legend": {
      "labelColor": "#4B5563",
      "titleColor": "#1F2933"
    }

  }
}
