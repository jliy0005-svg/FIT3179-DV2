{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 600,
  "height": 380,

  "data": {
    "url": "https://raw.githubusercontent.com/jliy0005-svg/FIT3179-DV2/main/data/mode_share_2025.csv",

    "format": {
      "type": "csv",

      "parse": {
        "Trips_Million_2024_25": "number",
        "Mode_Share_Percent_2024_25": "number",
        "Total_Trips_Million_2024_25": "number"
      }
    }
  },

  "layer": [

    {
      "mark": {
        "type": "rect",
        "color": "#ECEFF1",
        "stroke": "white",
        "strokeWidth": 2
      },

      "encoding": {

        "x": {
          "field": "Mode",
          "type": "nominal",

          "sort": [
            "Train",
            "Tram / light rail",
            "Bus",
            "Ferry"
          ],

          "title": null,

          "axis": {
            "labelFontSize": 12,
            "labelAngle": 0,
            "labelPadding": 8
          }
        },

        "y": {
          "field": "City",
          "type": "nominal",

          "sort": [
            "Sydney",
            "Melbourne",
            "Brisbane",
            "Perth",
            "Adelaide",
            "Canberra",
            "Hobart",
            "Darwin"
          ],

          "title": null,

          "axis": {
            "labelFontSize": 12,
            "labelPadding": 8
          }
        },

        "tooltip": [

          {
            "field": "City",
            "type": "nominal",
            "title": "Capital city"
          },

          {
            "field": "Mode",
            "type": "nominal",
            "title": "Transport mode"
          },

          {
            "field": "Data_Status",
            "type": "nominal",
            "title": "Data status"
          }

        ]
      }
    },


    {
      "transform": [
        {
          "filter": "isValid(datum.Mode_Share_Percent_2024_25)"
        }
      ],

      "mark": {
        "type": "rect",
        "stroke": "white",
        "strokeWidth": 2
      },

      "encoding": {

        "x": {
          "field": "Mode",
          "type": "nominal",

          "sort": [
            "Train",
            "Tram / light rail",
            "Bus",
            "Ferry"
          ],

          "title": null
        },

        "y": {
          "field": "City",
          "type": "nominal",

          "sort": [
            "Sydney",
            "Melbourne",
            "Brisbane",
            "Perth",
            "Adelaide",
            "Canberra",
            "Hobart",
            "Darwin"
          ],

          "title": null
        },

        "color": {
          "field": "Mode_Share_Percent_2024_25",
          "type": "quantitative",

          "title": "Share of city trips (%)",

          "scale": {
            "scheme": "blues",
            "domain": [
              0,
              100
            ]
          },

          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 260,
            "titleFontSize": 12,
            "labelFontSize": 11
          }
        },

        "tooltip": [

          {
            "field": "City",
            "type": "nominal",
            "title": "Capital city"
          },

          {
            "field": "Mode",
            "type": "nominal",
            "title": "Transport mode"
          },

          {
            "field": "Mode_Share_Percent_2024_25",
            "type": "quantitative",
            "title": "Share of city trips",
            "format": ".1f"
          },

          {
            "field": "Trips_Million_2024_25",
            "type": "quantitative",
            "title": "Passenger trips (million)",
            "format": ".1f"
          }

        ]
      }
    }

  ],

  "config": {

    "background": "white",

    "view": {
      "stroke": null
    },

    "font": "Arial",

    "axis": {
      "domain": false,
      "ticks": false,
      "labelColor": "#4B5563",
      "titleColor": "#374151"
    },

    "legend": {
      "labelColor": "#4B5563",
      "titleColor": "#1F2933"
    }

  }
}
