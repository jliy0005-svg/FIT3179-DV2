{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "description": "Heatmap comparing public transport mode shares across Australian capital cities while distinguishing reported values from unavailable data.",

  "width": 620,
  "height": 310,

  "data": {
    "url": "https://raw.githubusercontent.com/jliy0005-svg/FIT3179-DV2/main/data/mode_share_2025.csv"
  },

  "transform": [

    {
      "calculate": "datum.Data_Status == 'reported' ? format(datum.Mode_Share_Percent_2024_25, '.0f') + '%' : datum.Data_Status == 'not_applicable' ? 'N/A' : '—'",
      "as": "Cell_Label"
    },

    {
      "calculate": "datum.Data_Status == 'reported' ? 'Reported' : datum.Data_Status == 'not_applicable' ? 'Not applicable' : 'Negligible / unavailable'",
      "as": "Status_Label"
    },

    {
      "calculate": "datum.Data_Status == 'reported' ? format(datum.Mode_Share_Percent_2024_25, '.1f') + '%' : datum.Status_Label",
      "as": "Share_Label"
    }

  ],

  "layer": [

    {
      "mark": {
        "type": "rect",
        "stroke": "#FFFFFF",
        "strokeWidth": 1.2
      },

      "encoding": {

        "x": {
          "field": "Mode",
          "type": "nominal",

          "sort": [
            "Train",
            "Tram / light rail",
            "Bus",
            "Ferry"
          ],

          "axis": {
            "title": null,
            "labelAngle": 0,
            "labelFontSize": 11,
            "labelPadding": 8
          }
        },

        "y": {
          "field": "City",
          "type": "nominal",

          "sort": [
            "Sydney",
            "Melbourne",
            "Brisbane",
            "Perth",
            "Adelaide",
            "Canberra",
            "Hobart",
            "Darwin"
          ],

          "axis": {
            "title": null,
            "labelFontSize": 11,
            "labelPadding": 8
          }
        },

        "color": {

          "condition": {
            "test": "datum.Data_Status == 'reported'",
            "field": "Mode_Share_Percent_2024_25",
            "type": "quantitative",

            "scale": {
              "domain": [0, 100],
              "scheme": "blues"
            },

            "legend": {
              "title": "Share of city trips (%)",
              "orient": "bottom",
              "direction": "horizontal",
              "gradientLength": 220,
              "titleFontSize": 12,
              "labelFontSize": 11
            }
          },

          "value": "#E5E7EB"
        },

        "tooltip": [
          {
            "field": "City",
            "type": "nominal",
            "title": "Capital city"
          },
          {
            "field": "Mode",
            "type": "nominal",
            "title": "Transport mode"
          },
          {
            "field": "Share_Label",
            "type": "nominal",
            "title": "Mode share / status"
          },
          {
            "field": "Trips_Million_2024_25",
            "type": "quantitative",
            "title": "Passenger trips (million)",
            "format": ".1f"
          }
        ]
      }
    },

    {
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 600
      },

      "encoding": {

        "x": {
          "field": "Mode",
          "type": "nominal",

          "sort": [
            "Train",
            "Tram / light rail",
            "Bus",
            "Ferry"
          ]
        },

        "y": {
          "field": "City",
          "type": "nominal",

          "sort": [
            "Sydney",
            "Melbourne",
            "Brisbane",
            "Perth",
            "Adelaide",
            "Canberra",
            "Hobart",
            "Darwin"
          ]
        },

        "text": {
          "field": "Cell_Label",
          "type": "nominal"
        },

        "color": {

          "condition": {
            "test": "datum.Data_Status == 'reported' && datum.Mode_Share_Percent_2024_25 >= 55",
            "value": "#FFFFFF"
          },

          "value": "#334155"
        }
      }
    }

  ],

  "config": {

    "background": null,

    "view": {
      "stroke": null
    },

    "font": "Barlow"
  }
}
