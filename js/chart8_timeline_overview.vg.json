{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "data": {
    "url": "https://raw.githubusercontent.com/jliy0005-svg/FIT3179-DV2/main/data/city_totals_long.csv",

    "format": {
      "type": "csv",

      "parse": {
        "Year_Start": "number",
        "Year_End": "number",
        "Total_Trips_Million": "number"
      }
    }
  },

  "params": [
    {
      "name": "CitySelection",

      "value": "Sydney",

      "bind": {
        "input": "select",

        "options": [
          "Sydney",
          "Melbourne",
          "Brisbane",
          "Adelaide",
          "Perth",
          "Hobart",
          "Darwin",
          "Canberra"
        ],

        "name": "Choose a capital: "
      }
    }
  ],

  "vconcat": [

    {
      "width": 700,
      "height": 330,

      "transform": [
        {
          "filter": "datum.City == CitySelection"
        }
      ],

      "layer": [

        {
          "mark": {
            "type": "line",
            "strokeWidth": 3,
            "color": "#173F5F"
          },

          "encoding": {

            "x": {
              "field": "Year_Start",
              "type": "quantitative",

              "title": null,

              "scale": {
                "domain": {
                  "param": "brush"
                }
              },

              "axis": {
                "format": "d",

                "values": [
                  1976,
                  1980,
                  1985,
                  1990,
                  1995,
                  2000,
                  2005,
                  2010,
                  2015,
                  2020,
                  2024
                ],

                "labelFontSize": 11,
                "labelAngle": 0
              }
            },

            "y": {
              "field": "Total_Trips_Million",
              "type": "quantitative",

              "title": "Passenger trips (million)",

              "scale": {
                "zero": true
              },

              "axis": {
                "grid": true,
                "gridColor": "#E5E7EB",
                "labelFontSize": 11,
                "titleFontSize": 12
              }
            }
          }
        },


        {
          "mark": {
            "type": "circle",
            "size": 55,
            "color": "#173F5F",
            "opacity": 0
          },

          "encoding": {

            "x": {
              "field": "Year_Start",
              "type": "quantitative"
            },

            "y": {
              "field": "Total_Trips_Million",
              "type": "quantitative"
            },

            "tooltip": [

              {
                "field": "City",
                "type": "nominal",
                "title": "Capital city"
              },

              {
                "field": "Financial_Year",
                "type": "nominal",
                "title": "Financial year"
              },

              {
                "field": "Total_Trips_Million",
                "type": "quantitative",
                "title": "Passenger trips (million)",
                "format": ".1f"
              }

            ]
          }
        },


        {
          "data": {
            "values": [
              {
                "Year": 2020
              }
            ]
          },

          "mark": {
            "type": "rule",
            "color": "#9CA3AF",
            "strokeWidth": 1.5,
            "strokeDash": [
              5,
              4
            ]
          },

          "encoding": {

            "x": {
              "field": "Year",
              "type": "quantitative"
            }
          }
        },


        {
          "data": {
            "values": [
              {
                "Year": 2020,
                "Label": "COVID-19"
              }
            ]
          },

          "mark": {
            "type": "text",
            "align": "left",
            "dx": 7,
            "dy": -135,
            "fontSize": 11,
            "fontWeight": "bold",
            "color": "#6B7280"
          },

          "encoding": {

            "x": {
              "field": "Year",
              "type": "quantitative"
            },

            "text": {
              "field": "Label"
            }
          }
        }

      ]
    },


    {
      "width": 700,
      "height": 80,

      "transform": [
        {
          "filter": "datum.City == CitySelection"
        }
      ],

      "mark": {
        "type": "area",
        "color": "#AFC4D1",
        "opacity": 0.8,
        "line": {
          "color": "#557084",
          "strokeWidth": 1.5
        }
      },

      "params": [
        {
          "name": "brush",

          "select": {
            "type": "interval",

            "encodings": [
              "x"
            ]
          }
        }
      ],

      "encoding": {

        "x": {
          "field": "Year_Start",
          "type": "quantitative",

          "title": "Drag across this timeline to focus on a period",

          "axis": {
            "format": "d",

            "values": [
              1976,
              1985,
              1995,
              2005,
              2015,
              2024
            ],

            "labelFontSize": 10,
            "titleFontSize": 11
          }
        },

        "y": {
          "field": "Total_Trips_Million",
          "type": "quantitative",

          "axis": null,

          "title": null
        }
      }
    }

  ],

  "spacing": 18,

  "config": {

    "background": "white",

    "view": {
      "stroke": null
    },

    "font": "Arial",

    "axis": {
      "domain": false,
      "tickColor": "#CBD5E1",
      "labelColor": "#4B5563",
      "titleColor": "#374151"
    }

  }
}
