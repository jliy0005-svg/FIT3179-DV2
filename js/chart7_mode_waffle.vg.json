{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 520,
  "height": 420,

  "data": {
    "url": "https://raw.githubusercontent.com/jliy0005-svg/FIT3179-DV2/main/data/chart7_waffle.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Column": "number",
        "Row": "number",
        "Share_Percent_2024_25": "number",
        "Trips_Million_2024_25": "number"
      }
    }
  },

  "mark": {
    "type": "rect",
    "cornerRadius": 2,
    "stroke": "white",
    "strokeWidth": 1.5
  },

  "encoding": {

    "x": {
      "field": "Column",
      "type": "ordinal",
      "axis": null
    },

    "y": {
      "field": "Row",
      "type": "ordinal",
      "sort": "ascending",
      "axis": null
    },

    "color": {
      "field": "Mode",
      "type": "nominal",
      "title": "Transport mode",

      "scale": {
        "domain": [
          "Train",
          "Tram / light rail",
          "Bus",
          "Ferry"
        ],

        "range": [
          "#2F5597",
          "#E69F00",
          "#2A9D8F",
          "#7B61A8"
        ]
      },

      "legend": {
        "orient": "bottom",
        "direction": "horizontal",
        "titleFontSize": 12,
        "labelFontSize": 11,
        "symbolSize": 120
      }
    },

    "tooltip": [
      {
        "field": "Mode",
        "type": "nominal",
        "title": "Transport mode"
      },

      {
        "field": "Share_Percent_2024_25",
        "type": "quantitative",
        "title": "Share of trips",
        "format": ".1f"
      },

      {
        "field": "Trips_Million_2024_25",
        "type": "quantitative",
        "title": "Passenger trips (million)",
        "format": ".1f"
      }
    ]
  },

  "config": {
    "background": "white",

    "view": {
      "stroke": null
    },

    "font": "Arial",

    "legend": {
      "labelColor": "#4B5563",
      "titleColor": "#1F2933"
    }
  }
}
