{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 650,
  "height": 450,

  "projection": {
    "type": "mercator"
  },

  "layer": [

    {
      "data": {
        "url": "https://vega.github.io/vega-datasets/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },

      "transform": [
        {
          "filter": "datum.id == 36"
        }
      ],

      "mark": {
        "type": "geoshape",
        "fill": "#E8ECEF",
        "stroke": "#AAB4BC",
        "strokeWidth": 0.8
      }
    },

    {
      "data": {
        "url": "data/gccsa_capitals_2021.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },

      "transform": [

        {
          "calculate": "datum.properties.gccsa_name_2021",
          "as": "GCCSA_Name"
        },

        {
          "lookup": "GCCSA_Name",

          "from": {

            "data": {
              "url": "data/city_summary_choropleth_ready.csv",
              "format": {
                "type": "csv",

                "parse": {
                  "Trips_Per_Resident_2024_25": "number",
                  "Total_Trips_Million_2024_25": "number",
                  "Population_2025": "number"
                }
              }
            },

            "key": "GCCSA_Name",

            "fields": [
              "City",
              "Trips_Per_Resident_2024_25",
              "Total_Trips_Million_2024_25",
              "Population_2025"
            ]
          }
        }

      ],

      "mark": {
        "type": "geoshape",
        "stroke": "#FFFFFF",
        "strokeWidth": 1.2
      },

      "encoding": {

        "shape": {
          "field": "geometry",
          "type": "geojson"
        },

        "color": {
          "field": "Trips_Per_Resident_2024_25",
          "type": "quantitative",

          "title": "Trips per resident",

          "scale": {
            "scheme": "blues",
            "domain": [0, 130]
          },

          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 220,
            "titleFontSize": 12,
            "labelFontSize": 11
          }
        },

        "tooltip": [

          {
            "field": "City",
            "type": "nominal",
            "title": "Capital city"
          },

          {
            "field": "GCCSA_Name",
            "type": "nominal",
            "title": "Capital region"
          },

          {
            "field": "Trips_Per_Resident_2024_25",
            "type": "quantitative",
            "title": "Trips per resident",
            "format": ".1f"
          },

          {
            "field": "Total_Trips_Million_2024_25",
            "type": "quantitative",
            "title": "Passenger trips (million)",
            "format": ".1f"
          },

          {
            "field": "Population_2025",
            "type": "quantitative",
            "title": "Population",
            "format": ",.0f"
          }

        ]
      }
    }

  ],

  "config": {

    "background": "white",

    "view": {
      "stroke": null
    },

    "font": "Arial",

    "legend": {
      "labelColor": "#4B5563",
      "titleColor": "#1F2933"
    }

  }
}
