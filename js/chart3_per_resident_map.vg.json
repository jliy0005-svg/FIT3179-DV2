{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 650,
  "height": 450,

  "projection": {
    "type": "mercator"
  },

  "data": {
    "url": "https://geo.abs.gov.au/arcgis/rest/services/ASGS2021/GCCSA/MapServer/0/query?where=1%3D1&outFields=gccsa_name_2021%2Cgccsa_code_2021&returnGeometry=true&outSR=4326&f=geojson",
    "format": {
      "type": "json",
      "property": "features"
    }
  },

  "layer": [

    {
      "mark": {
        "type": "geoshape",
        "fill": "#E8ECEF",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.7
      }
    },

    {
      "transform": [

        {
          "lookup": "properties.gccsa_name_2021",

          "from": {

            "data": {
              "url": "https://raw.githubusercontent.com/jliy0005-svg/FIT3179-DV2/refs/heads/main/data/city_summary_choropleth_ready.csv",

              "format": {
                "type": "csv",

                "parse": {
                  "Trips_Per_Resident_2024_25": "number",
                  "Total_Trips_Million_2024_25": "number",
                  "Population_2025": "number"
                }
              }
            },

            "key": "GCCSA_Name",

            "fields": [
              "City",
              "Trips_Per_Resident_2024_25",
              "Total_Trips_Million_2024_25",
              "Population_2025"
            ]
          }
        },

        {
          "filter": "isValid(datum.Trips_Per_Resident_2024_25)"
        }

      ],

      "mark": {
        "type": "geoshape",
        "stroke": "#FFFFFF",
        "strokeWidth": 1
      },

      "encoding": {

        "color": {
          "field": "Trips_Per_Resident_2024_25",
          "type": "quantitative",

          "title": "Trips per resident",

          "scale": {
            "scheme": "blues",
            "domain": [0, 130]
          },

          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 220,
            "titleFontSize": 12,
            "labelFontSize": 11
          }
        },

        "tooltip": [

          {
            "field": "City",
            "type": "nominal",
            "title": "Capital city"
          },

          {
            "field": "Trips_Per_Resident_2024_25",
            "type": "quantitative",
            "title": "Trips per resident",
            "format": ".1f"
          },

          {
            "field": "Total_Trips_Million_2024_25",
            "type": "quantitative",
            "title": "Passenger trips (million)",
            "format": ".1f"
          },

          {
            "field": "Population_2025",
            "type": "quantitative",
            "title": "Population",
            "format": ",.0f"
          }

        ]
      }
    }

  ],

  "config": {

    "background": "white",

    "view": {
      "stroke": null
    },

    "font": "Arial",

    "legend": {
      "labelColor": "#4B5563",
      "titleColor": "#1F2933"
    }

  }
}
