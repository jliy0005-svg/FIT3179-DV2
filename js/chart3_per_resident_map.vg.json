{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 650,
  "height": 450,

  "projection": {
    "type": "mercator"
  },

  "layer": [

    {
      "data": {
        "url": "https://vega.github.io/vega-datasets/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },

      "transform": [
        {
          "filter": "datum.id == 36"
        }
      ],

      "mark": {
        "type": "geoshape",
        "fill": "#E8ECEF",
        "stroke": "#AAB4BC",
        "strokeWidth": 0.7
      }
    },

    {
      "data": {
        "url": "https://raw.githubusercontent.com/jliy0005-svg/FIT3179-DV2/refs/heads/main/data/city_summary_choropleth_ready.csv",

        "format": {
          "type": "csv",

          "parse": {
            "Trips_Per_Resident_2024_25": "number",
            "Total_Trips_Million_2024_25": "number",
            "Population_2025": "number"
          }
        }
      },

      "transform": [

        {
          "lookup": "GCCSA_Name",

          "from": {

            "data": {
              "url": "https://geo.abs.gov.au/arcgis/rest/services/ASGS2021/GCCSA/MapServer/1/query?where=1%3D1&outFields=gccsa_name_2021%2Cgccsa_code_2021&returnGeometry=true&outSR=4326&f=geojson",

              "format": {
                "type": "json",
                "property": "features"
              }
            },

            "key": "properties.gccsa_name_2021"
          },

          "as": "geo"
        },

        {
          "filter": "isValid(datum.geo)"
        }

      ],

      "mark": {
        "type": "geoshape",
        "stroke": "#FFFFFF",
        "strokeWidth": 1
      },

      "encoding": {

        "shape": {
          "field": "geo",
          "type": "geojson"
        },

        "color": {
          "field": "Trips_Per_Resident_2024_25",
          "type": "quantitative",

          "title": "Trips per resident",

          "scale": {
            "scheme": "blues",
            "domain": [0, 130]
          },

          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 220,
            "titleFontSize": 12,
            "labelFontSize": 11
          }
        },

        "tooltip": [

          {
            "field": "City",
            "type": "nominal",
            "title": "Capital city"
          },

          {
            "field": "Trips_Per_Resident_2024_25",
            "type": "quantitative",
            "title": "Trips per resident",
            "format": ".1f"
          },

          {
            "field": "Total_Trips_Million_2024_25",
            "type": "quantitative",
            "title": "Passenger trips (million)",
            "format": ".1f"
          },

          {
            "field": "Population_2025",
            "type": "quantitative",
            "title": "Population",
            "format": ",.0f"
          }

        ]
      }
    }

  ],

  "config": {

    "background": "white",

    "view": {
      "stroke": null
    },

    "font": "Arial",

    "legend": {
      "labelColor": "#4B5563",
      "titleColor": "#1F2933"
    }

  }
}
