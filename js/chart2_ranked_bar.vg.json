{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 600,
  "height": 360,

  "data": {
    "url": "https://raw.githubusercontent.com/jliy0005-svg/FIT3179-DV2/refs/heads/main/data/city_summary_chart_ready.csv",
    "format": {
      "type": "csv"
    }
  },

  "layer": [

    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 3,
        "color": "#466A82"
      },

      "encoding": {

        "y": {
          "field": "City",
          "type": "nominal",
          "sort": {
            "field": "Total_Trips_Million_2024_25",
            "order": "descending"
          },
          "title": null,
          "axis": {
            "labelFontSize": 12,
            "labelPadding": 8
          }
        },

        "x": {
          "field": "Total_Trips_Million_2024_25",
          "type": "quantitative",
          "title": "Passenger trips (million)",
          "axis": {
            "grid": true,
            "gridColor": "#E5E7EB",
            "titleFontSize": 12,
            "labelFontSize": 11
          }
        },

        "tooltip": [
          {
            "field": "City",
            "type": "nominal",
            "title": "Capital city"
          },
          {
            "field": "Total_Trips_Million_2024_25",
            "type": "quantitative",
            "title": "Passenger trips (million)",
            "format": ".1f"
          },
          {
            "field": "Trips_Per_Resident_2024_25",
            "type": "quantitative",
            "title": "Trips per resident",
            "format": ".1f"
          }
        ]
      }
    },

    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 6,
        "fontSize": 11,
        "color": "#374151"
      },

      "encoding": {

        "y": {
          "field": "City",
          "type": "nominal",
          "sort": {
            "field": "Total_Trips_Million_2024_25",
            "order": "descending"
          }
        },

        "x": {
          "field": "Total_Trips_Million_2024_25",
          "type": "quantitative"
        },

        "text": {
          "field": "Total_Trips_Million_2024_25",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    }
  ],

  "config": {

    "background": "white",

    "view": {
      "stroke": null
    },

    "font": "Arial",

    "axis": {
      "domain": false,
      "tickColor": "#CBD5E1",
      "labelColor": "#4B5563",
      "titleColor": "#374151"
    }
  }
}