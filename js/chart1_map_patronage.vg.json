{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 600,
  "height": 430,

  "title": {
    "text": "Public Transport Patronage Across Australian Capitals",
    "subtitle": "Annual passenger trips, 2024–25",
    "anchor": "start",
    "fontSize": 18,
    "subtitleFontSize": 12
  },

  "projection": {
    "type": "mercator"
  },

  "layer": [

    {
      "data": {
        "url": "https://vega.github.io/vega-datasets/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },

      "transform": [
        {
          "filter": "datum.id == 36"
        }
      ],

      "mark": {
        "type": "geoshape",
        "fill": "#E8ECEF",
        "stroke": "#AAB4BC",
        "strokeWidth": 0.8
      }
    },

    {
      "data": {
        "values": [
          {
            "City": "Sydney",
            "Latitude": -33.8688,
            "Longitude": 151.2093,
            "Total": 708.551942,
            "TripsPerResident": 125.655844,
            "DominantMode": "Train"
          },
          {
            "City": "Melbourne",
            "Latitude": -37.8136,
            "Longitude": 144.9631,
            "Total": 480.203830,
            "TripsPerResident": 88.344380,
            "DominantMode": "Train"
          },
          {
            "City": "Brisbane",
            "Latitude": -27.4698,
            "Longitude": 153.0251,
            "Total": 161.642128,
            "TripsPerResident": 57.046324,
            "DominantMode": "Bus"
          },
          {
            "City": "Adelaide",
            "Latitude": -34.9285,
            "Longitude": 138.6007,
            "Total": 69.588980,
            "TripsPerResident": 46.672220,
            "DominantMode": "Bus"
          },
          {
            "City": "Perth",
            "Latitude": -31.9505,
            "Longitude": 115.8605,
            "Total": 148.717496,
            "TripsPerResident": 60.632591,
            "DominantMode": "Bus"
          },
          {
            "City": "Hobart",
            "Latitude": -42.8821,
            "Longitude": 147.3272,
            "Total": 6.716977,
            "TripsPerResident": 26.315286,
            "DominantMode": "Bus"
          },
          {
            "City": "Darwin",
            "Latitude": -12.4634,
            "Longitude": 130.8456,
            "Total": 4.646000,
            "TripsPerResident": 29.168027,
            "DominantMode": "Bus"
          },
          {
            "City": "Canberra",
            "Latitude": -35.2809,
            "Longitude": 149.1300,
            "Total": 20.582000,
            "TripsPerResident": 42.469513,
            "DominantMode": "Bus"
          }
        ]
      },

      "mark": {
        "type": "circle",
        "color": "#173F5F",
        "opacity": 0.8,
        "stroke": "white",
        "strokeWidth": 1.2
      },

      "encoding": {

        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },

        "size": {
          "field": "Total",
          "type": "quantitative",
          "title": "Passenger trips (million)",
          "scale": {
            "range": [70, 1600]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal"
          }
        },

        "tooltip": [
          {
            "field": "City",
            "type": "nominal",
            "title": "Capital city"
          },
          {
            "field": "Total",
            "type": "quantitative",
            "title": "Passenger trips",
            "format": ".1f"
          },
          {
            "field": "TripsPerResident",
            "type": "quantitative",
            "title": "Trips per resident",
            "format": ".1f"
          },
          {
            "field": "DominantMode",
            "type": "nominal",
            "title": "Dominant mode"
          }
        ]
      }
    }
  ],

  "config": {
    "background": "white",
    "view": {
      "stroke": null
    },
    "font": "Arial"
  }
}