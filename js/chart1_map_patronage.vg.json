{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Proportional symbol map of 2024-25 public transport patronage across Australian capital cities.",

  "width": 650,
  "height": 410,

  "projection": {
    "type": "equalEarth"
  },

  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/vega/vega-datasets/master/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },

      "transform": [
        {
          "filter": "datum.id == 36"
        }
      ],

      "mark": {
        "type": "geoshape",
        "fill": "#E8ECEF",
        "stroke": "#AAB4BC",
        "strokeWidth": 0.8
      }
    },

    {
      "data": {
        "url": "https://raw.githubusercontent.com/jliy0005-svg/FIT3179-DV2/main/data/city_summary_chart_ready.csv"
      },

      "mark": {
        "type": "circle",
        "opacity": 0.82,
        "stroke": "#FFFFFF",
        "strokeWidth": 1.2,
        "color": "#173F5F"
      },

      "encoding": {

        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },

        "size": {
          "field": "Total_Trips_Million_2024_25",
          "type": "quantitative",
          "title": "Passenger trips (million)",

          "scale": {
            "domain": [0, 800],
            "range": [0, 1800]
          },

          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "values": [200, 400, 600, 800],
            "title": "Passenger trips (million)",
            "titleFontSize": 12,
            "labelFontSize": 11,
            "symbolOpacity": 0.82
          }
        },

        "tooltip": [
          {
            "field": "City",
            "type": "nominal",
            "title": "Capital city"
          },
          {
            "field": "Total_Trips_Million_2024_25",
            "type": "quantitative",
            "title": "Passenger trips (million)",
            "format": ",.1f"
          },
          {
            "field": "Trips_Per_Resident_2024_25",
            "type": "quantitative",
            "title": "Trips per resident",
            "format": ".1f"
          },
          {
            "field": "Dominant_Mode",
            "type": "nominal",
            "title": "Dominant mode"
          }
        ]
      }
    }
  ],

  "config": {
    "background": null,

    "view": {
      "stroke": null
    },

    "font": "Barlow"
  }
}
