{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 600,
  "height": 430,

  "title": {
    "text": "Public Transport Patronage Across Australian Capitals",
    "subtitle": "Annual passenger trips, 2024–25",
    "anchor": "start",
    "fontSize": 18,
    "subtitleFontSize": 12
  },

  "projection": {
    "type": "mercator"
  },

  "layer": [

    {
      "data": {
        "url": "https://vega.github.io/vega-datasets/data/world-110m.json",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },

      "transform": [
        {
          "filter": "datum.id == 36"
        }
      ],

      "mark": {
        "type": "geoshape",
        "fill": "#E8ECEF",
        "stroke": "#AAB4BC",
        "strokeWidth": 0.8
      }
    },

    {
      "data": {
        "url": "https://raw.githubusercontent.com/jliy0005-svg/FIT3179-DV2/refs/heads/main/data/city_summary_chart_ready.csv",
        "format": {
          "type": "csv"
        }
      },

      "mark": {
        "type": "circle",
        "color": "#173F5F",
        "opacity": 0.8,
        "stroke": "white",
        "strokeWidth": 1.2
      },

      "encoding": {

        "longitude": {
          "field": "Longitude",
          "type": "quantitative"
        },

        "latitude": {
          "field": "Latitude",
          "type": "quantitative"
        },

        "size": {
          "field": "Total_Trips_Million_2024_25",
          "type": "quantitative",
          "title": "Passenger trips (million)",
          "scale": {
            "range": [70, 1600]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "titleFontSize": 12,
            "labelFontSize": 11
          }
        },

        "tooltip": [
          {
            "field": "City",
            "type": "nominal",
            "title": "Capital city"
          },
          {
            "field": "Total_Trips_Million_2024_25",
            "type": "quantitative",
            "title": "Passenger trips (million)",
            "format": ".1f"
          },
          {
            "field": "Trips_Per_Resident_2024_25",
            "type": "quantitative",
            "title": "Trips per resident",
            "format": ".1f"
          },
          {
            "field": "Dominant_Mode",
            "type": "nominal",
            "title": "Dominant mode"
          }
        ]
      }
    }
  ],

  "config": {
    "background": "white",

    "view": {
      "stroke": null
    },

    "font": "Arial",

    "title": {
      "color": "#1F2933"
    },

    "legend": {
      "labelColor": "#4B5563",
      "titleColor": "#1F2933"
    }
  }
}
